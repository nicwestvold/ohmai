<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.westvold.ohmai.lidhelper</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/ohmai-lidhelper</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.westvold.ohmai</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>com.westvold.ohmai.lidhelper</key>
		<true/>
	</dict>
	<!-- Start at boot so the startup reset runs even if ohmai never launches. -->
	<key>RunAtLoad</key>
	<true/>
	<!-- Respawn after a crash (so the startup reset runs again), not after a clean exit. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
</dict>
</plist>
